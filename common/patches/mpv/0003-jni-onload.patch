+++ b/osdep/android/jni_onload.c
@@ -0,0 +1,29 @@
+/* JNI_OnLoad for libmpv on Android.
+ *
+ * mpv does not call av_jni_set_java_vm() anywhere - it only reads the VM via
+ * av_jni_get_java_vm() (misc/jni.c). On Android the JavaVM must therefore be
+ * registered from outside, which the Android runtime does by calling the
+ * JNI_OnLoad() entry point of a library after System.loadLibrary().
+ *
+ * We export JNI_OnLoad() (marked JNIEXPORT so it survives mpv's hidden-visibility
+ * library and -Bsymbolic) so a host app that loads libmpv.so gets the VM registered
+ * automatically; the Android AOs (audiotrack/aaudio) and MediaCodec hwdec then find it.
+ *
+ * This adds no public C client API: JNI_OnLoad is a JNI-level, not an mpv_* symbol.
+ */
+
+#include <jni.h>
+#include <libavcodec/jni.h>
+
+JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM *vm, void *reserved)
+{
+    (void)reserved;
+    av_jni_set_java_vm(vm, NULL);
+    return JNI_VERSION_1_6;
+}
+
+JNIEXPORT void JNICALL JNI_OnUnload(JavaVM *vm, void *reserved)
+{
+    (void)vm;
+    (void)reserved;
+}
