diff --git a/third_party/libass-stub/ass_stub.c b/third_party/libass-stub/ass_stub.c
new file mode 100644
index 0000000..94853df
--- /dev/null
+++ b/third_party/libass-stub/ass_stub.c
@@ -0,0 +1,152 @@
+/*
+ * libass API stub for libmmpv builds.
+ *
+ * Provides the subset of the libass API that mpv v0.42 references, with
+ * behaviour "no subtitle/OSD text rendering": tracks and events are kept as
+ * plain data (so mpv's bookkeeping works), but nothing is ever rendered
+ * (ass_render_frame() returns NULL). This removes libass, freetype, harfbuzz,
+ * fribidi and fontconfig from the dependency tree.
+ *
+ * License: LGPL-2.1+ (same as mpv's LGPL build).
+ */
+#include <stdlib.h>
+#include <string.h>
+#include <ass/ass.h>
+
+struct ass_library { int dummy; };
+struct ass_renderer { int dummy; };
+
+ASS_Library *ass_library_init(void) { return calloc(1, sizeof(struct ass_library)); }
+void ass_library_done(ASS_Library *priv) { free(priv); }
+int ass_library_version(void) { return LIBASS_VERSION; }
+void ass_set_fonts_dir(ASS_Library *priv, const char *d) { (void)priv; (void)d; }
+void ass_set_extract_fonts(ASS_Library *priv, int e) { (void)priv; (void)e; }
+void ass_set_style_overrides(ASS_Library *priv, const char *const *l) { (void)priv; (void)l; }
+void ass_add_font(ASS_Library *l, const char *n, const char *d, int s) { (void)l; (void)n; (void)d; (void)s; }
+void ass_set_message_cb(ASS_Library *priv,
+                        void (*cb)(int, const char *, va_list, void *), void *d)
+{ (void)priv; (void)cb; (void)d; }
+
+ASS_Renderer *ass_renderer_init(ASS_Library *lib)
+{
+    (void)lib;
+    return calloc(1, sizeof(struct ass_renderer));
+}
+void ass_renderer_done(ASS_Renderer *priv) { free(priv); }
+void ass_set_frame_size(ASS_Renderer *p, int w, int h) { (void)p; (void)w; (void)h; }
+void ass_set_storage_size(ASS_Renderer *p, int w, int h) { (void)p; (void)w; (void)h; }
+void ass_set_shaper(ASS_Renderer *p, ASS_ShapingLevel l) { (void)p; (void)l; }
+void ass_set_margins(ASS_Renderer *p, int t, int b, int l, int r) { (void)p; (void)t; (void)b; (void)l; (void)r; }
+void ass_set_use_margins(ASS_Renderer *p, int u) { (void)p; (void)u; }
+void ass_set_pixel_aspect(ASS_Renderer *p, double a) { (void)p; (void)a; }
+void ass_set_font_scale(ASS_Renderer *p, double s) { (void)p; (void)s; }
+void ass_set_hinting(ASS_Renderer *p, ASS_Hinting h) { (void)p; (void)h; }
+void ass_set_line_spacing(ASS_Renderer *p, double s) { (void)p; (void)s; }
+void ass_set_line_position(ASS_Renderer *p, double s) { (void)p; (void)s; }
+void ass_set_cache_limits(ASS_Renderer *p, int g, int b) { (void)p; (void)g; (void)b; }
+void ass_set_selective_style_override_enabled(ASS_Renderer *p, int b) { (void)p; (void)b; }
+void ass_set_selective_style_override(ASS_Renderer *p, ASS_Style *s) { (void)p; (void)s; }
+void ass_set_fonts(ASS_Renderer *p, const char *df, const char *dfam, int dfp,
+                   const char *cfg, int update)
+{ (void)p; (void)df; (void)dfam; (void)dfp; (void)cfg; (void)update; }
+
+ASS_Image *ass_render_frame(ASS_Renderer *p, ASS_Track *t, long long now,
+                            int *detect_change)
+{
+    (void)p; (void)t; (void)now;
+    if (detect_change)
+        *detect_change = 0;
+    return NULL;
+}
+
+ASS_Track *ass_new_track(ASS_Library *lib)
+{
+    ASS_Track *t = calloc(1, sizeof(*t));
+    if (t)
+        t->library = lib;
+    return t;
+}
+
+void ass_free_event(ASS_Track *track, int eid)
+{
+    ASS_Event *e = track->events + eid;
+    free(e->Name);
+    free(e->Effect);
+    free(e->Text);
+    e->Name = e->Effect = e->Text = NULL;
+}
+
+void ass_flush_events(ASS_Track *track)
+{
+    for (int i = 0; i < track->n_events; i++)
+        ass_free_event(track, i);
+    track->n_events = 0;
+}
+
+void ass_free_track(ASS_Track *track)
+{
+    if (!track)
+        return;
+    for (int i = 0; i < track->n_styles; i++) {
+        free(track->styles[i].Name);
+        free(track->styles[i].FontName);
+    }
+    free(track->styles);
+    ass_flush_events(track);
+    free(track->events);
+    free(track->style_format);
+    free(track->event_format);
+    free(track->Language);
+    free(track->name);
+    free(track);
+}
+
+int ass_alloc_style(ASS_Track *track)
+{
+    if (track->n_styles == track->max_styles) {
+        int n = track->max_styles ? track->max_styles * 2 : 8;
+        ASS_Style *s = realloc(track->styles, n * sizeof(*s));
+        if (!s)
+            return -1;
+        track->styles = s;
+        track->max_styles = n;
+    }
+    memset(track->styles + track->n_styles, 0, sizeof(ASS_Style));
+    return track->n_styles++;
+}
+
+int ass_alloc_event(ASS_Track *track)
+{
+    if (track->n_events == track->max_events) {
+        int n = track->max_events ? track->max_events * 2 : 64;
+        ASS_Event *e = realloc(track->events, n * sizeof(*e));
+        if (!e)
+            return -1;
+        track->events = e;
+        track->max_events = n;
+    }
+    memset(track->events + track->n_events, 0, sizeof(ASS_Event));
+    return track->n_events++;
+}
+
+void ass_process_codec_private(ASS_Track *track, const char *data, int size)
+{
+    (void)data; (void)size;
+    // Nothing is parsed; provide the Matroska default event layout so that
+    // callers reading event_format never see NULL.
+    if (!track->event_format)
+        track->event_format = strdup("ReadOrder, Layer, Style, Name, MarginL, "
+                                     "MarginR, MarginV, Effect, Text");
+    track->track_type = TRACK_TYPE_ASS;
+}
+
+void ass_process_chunk(ASS_Track *t, const char *d, int s, long long ts, long long dur)
+{ (void)t; (void)d; (void)s; (void)ts; (void)dur; }
+void ass_process_force_style(ASS_Track *t) { (void)t; }
+int ass_read_styles(ASS_Track *t, const char *f, const char *cp) { (void)t; (void)f; (void)cp; return -1; }
+void ass_configure_prune(ASS_Track *t, long long d) { (void)t; (void)d; }
+void ass_set_check_readorder(ASS_Track *t, int c) { (void)t; (void)c; }
+long long ass_step_sub(ASS_Track *t, long long now, int movement)
+{ (void)t; (void)now; (void)movement; return 0; }
+int ass_track_set_feature(ASS_Track *t, ASS_Feature f, int e)
+{ (void)t; (void)f; (void)e; return -1; }
